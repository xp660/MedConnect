<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.5" />
    <!-- dotnet-ef 工具需要「startup project」引用 Design 套件才能運作；純 design-time tooling，
         PrivateAssets=all 確保不會外洩成正式相依，Api 的程式碼本身不 using 任何 EF 型別。 -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MedConnect.Application\MedConnect.Application.csproj" />
    <ProjectReference Include="..\MedConnect.Infrastructure\MedConnect.Infrastructure.csproj" />
  </ItemGroup>

</Project>
