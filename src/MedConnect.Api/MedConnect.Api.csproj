<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>8ece659e-1ce9-4e9e-995b-23bade8fdb8e</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.5" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.5" />
    <!-- 結構化日誌（具名參數變成可查詢欄位）+ UseSerilog 主機整合 + Console sink + appsettings 設定 + JSON 格式，一個套件全包。
         只放在 Api（host）層；Domain/Application 只用 ILogger<T>（architecture-plan.md §0 v1.12）。 -->
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <!-- dotnet-ef 工具需要「startup project」引用 Design 套件才能運作；純 design-time tooling，
         PrivateAssets=all 確保不會外洩成正式相依，Api 的程式碼本身不 using 任何 EF 型別。 -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MedConnect.Application\MedConnect.Application.csproj" />
    <ProjectReference Include="..\MedConnect.Infrastructure\MedConnect.Infrastructure.csproj" />
  </ItemGroup>

</Project>
