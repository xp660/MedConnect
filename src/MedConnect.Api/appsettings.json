{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Database": {
    "MigrateOnStartup": false,
    "SeedDemoData": false
  },
  "Hosting": {
    "UseHttpsRedirection": true
  },
  "Jwt": {
    "Issuer": "MedConnect",
    "Audience": "MedConnect.Api",
    "ExpiryMinutes": 60
  },
  "AllowedHosts": "*"
}
